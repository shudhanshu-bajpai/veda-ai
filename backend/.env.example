# Port to bind to. Render/Railway inject PORT automatically — leave default if local.
PORT=5000

# MongoDB connection string (Atlas works out of the box).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/vedaai

# Gemini API key (https://aistudio.google.com/app/apikey).
GEMINI_API_KEY=AIzaSy...

# Optional Redis for queue + cache. If unreachable, app falls back to
# in-memory cache + synchronous job execution automatically.
REDIS_URL=redis://localhost:6379

# Used in CORS allowlist. Set to your deployed Vercel URL in production.
# Local default is fine for development.
FRONTEND_URL=http://localhost:3000
